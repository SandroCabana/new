# ==============================================================================
# DJANGO CORE SETTINGS
# ==============================================================================

# SECURITY WARNING: Generate a new secret key for production!
# Generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# SECURITY WARNING: Don't run with debug turned on in production!
DEBUG=False

# Comma-separated list of allowed hosts (e.g., example.com,www.example.com,localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://lti_user:secure_password_here@db:5432/lti_recommender_db

# Database connection settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lti_recommender_db
DB_USER=lti_user
DB_PASSWORD=secure_password_here
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ==============================================================================
# CACHE CONFIGURATION
# ==============================================================================

# Redis URL for caching (optional, will fallback to LocMemCache if not set)
REDIS_URL=redis://redis:6379/0

# Cache timeout in seconds
CACHE_TTL=300

# ==============================================================================
# LTI 1.3 CONFIGURATION
# ==============================================================================

# LTI Client ID from your LMS (Moodle, Canvas, etc.)
LTI_CLIENT_ID=your-client-id-from-moodle

# LMS Platform Issuer (e.g., https://your-moodle.com)
LTI_ISS=https://your-moodle-instance.com

# LTI Deployment ID
LTI_DEPLOYMENT_ID=1

# Tool URLs (update with your actual domain)
LTI_JWKS_URL=https://your-domain.com/lti/jwks/
LTI_AUTH_LOGIN_URL=https://your-domain.com/lti/login/
LTI_LAUNCH_URL=https://your-domain.com/lti/launch/

# Tool Information
LTI_TOOL_NAME=Sistema de Recomendación EPAI
LTI_TOOL_DESCRIPTION=Un sistema de recomendación de temas de interés para Moodle integrado con LTI.

# LMS Platform URLs (get these from your Moodle/Canvas instance)
MOODLE_AUTH_URL=https://your-moodle.com/mod/lti/auth.php
MOODLE_TOKEN_URL=https://your-moodle.com/mod/lti/token.php
MOODLE_JWKS_URL=https://your-moodle.com/mod/lti/certs.php

# LTI Advantage Services
ENABLE_NRPS=True
ENABLE_AGS=False
ENABLE_DEEP_LINKING=True

# RSA Key files (will be generated automatically if not exist)
LTI_PUBLIC_KEY_PATH=/app/keys/lti_public_key.pem
LTI_PRIVATE_KEY_PATH=/app/keys/lti_private_key.pem

# ==============================================================================
# MACHINE LEARNING / RECOMMENDATION ENGINE
# ==============================================================================

# Sentence Transformers model (will be downloaded on first run)
ML_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ML_EMBEDDING_DIMENSION=384

# Recommendation weights
ML_SIMILARITY_THRESHOLD=0.3
ML_CONTENT_WEIGHT=0.5
ML_USER_WEIGHT=0.3
ML_POPULARITY_WEIGHT=0.2

# Model storage path
ML_MODEL_PATH=/app/ml/saved_models

# ==============================================================================
# STATIC & MEDIA FILES
# ==============================================================================

# Static files URL
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles

# Media files URL and path
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Session security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=None

# CSRF security
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=None
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://your-moodle.com

# X-Frame-Options (allow embedding in LMS)
X_FRAME_OPTIONS=ALLOWALL

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log to file
LOG_FILE=/app/logs/django.log

# ==============================================================================
# GUNICORN SETTINGS
# ==============================================================================

# Number of worker processes
GUNICORN_WORKERS=4

# Worker timeout in seconds
GUNICORN_TIMEOUT=120

# Bind address
GUNICORN_BIND=0.0.0.0:8000

# ==============================================================================
# CELERY (Optional - for async tasks)
# ==============================================================================

# Celery broker URL
CELERY_BROKER_URL=redis://redis:6379/1

# Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==============================================================================
# DEVELOPMENT / DEBUGGING
# ==============================================================================

# Django Debug Toolbar (only for development)
ENABLE_DEBUG_TOOLBAR=False

# SQL Query logging
LOG_SQL_QUERIES=False

# ==============================================================================
# SUPERUSER (Auto-created on first run)
# ==============================================================================

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password
