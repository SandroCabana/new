# ==============================================================================
# DJANGO CORE SETTINGS
# ==============================================================================
SECRET_KEY=django-insecure-for-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE CONFIGURATION (Docker)
# ==============================================================================
DATABASE_URL=postgres://lti_user:lti_password@db:5432/lti_recommender_db
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lti_recommender_db
DB_USER=lti_user
DB_PASSWORD=lti_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ==============================================================================
# CACHE (Optional - Redis)
# ==============================================================================
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300

# ==============================================================================
# LTI 1.3 CONFIGURATION
# ==============================================================================
LTI_CLIENT_ID=your-client-id-from-moodle
LTI_ISS=https://your-moodle-instance.com
LTI_DEPLOYMENT_ID=1

# Tool URLs (update with your actual domain)
LTI_JWKS_URL=http://localhost:8000/lti/jwks/
LTI_AUTH_LOGIN_URL=http://localhost:8000/lti/login/
LTI_LAUNCH_URL=http://localhost:8000/lti/launch/

# Tool Information
LTI_TOOL_NAME=Sistema de Recomendación EPAI
LTI_TOOL_DESCRIPTION=Un sistema de recomendación de temas de interés para Moodle integrado con LTI.

# Moodle Platform URLs (update with your Moodle instance)
MOODLE_AUTH_URL=http://localhost/moodle/mod/lti/auth.php
MOODLE_TOKEN_URL=http://localhost/moodle/mod/lti/token.php
MOODLE_JWKS_URL=http://localhost/moodle/mod/lti/certs.php

# LTI Advantage Features
ENABLE_NRPS=True
ENABLE_AGS=False
ENABLE_DEEP_LINKING=True

# RSA Keys (generated automatically)
LTI_PUBLIC_KEY_PATH=/app/keys/lti_public_key.pem
LTI_PRIVATE_KEY_PATH=/app/keys/lti_private_key.pem

# ==============================================================================
# ML / RECOMMENDATION ENGINE
# ==============================================================================
ML_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ML_EMBEDDING_DIMENSION=384
ML_SIMILARITY_THRESHOLD=0.3
ML_CONTENT_WEIGHT=0.5
ML_USER_WEIGHT=0.3
ML_POPULARITY_WEIGHT=0.2
ML_MODEL_PATH=/app/ml/saved_models

# ==============================================================================
# STATIC & MEDIA
# ==============================================================================
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# ==============================================================================
# SECURITY (Development - less strict)
# ==============================================================================
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=None
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=DEBUG
LOG_FILE=/app/logs/django.log

# ==============================================================================
# GUNICORN
# ==============================================================================
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:8000

# ==============================================================================
# SUPERUSER (Development default)
# ==============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
